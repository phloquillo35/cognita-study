# Cognita Study — Variables de entorno
# Copiar a .env.local y completar: cp .env.example .env.local

# OpenAI (opcional en dev — sin esto funciona en modo mock)
OPENAI_API_KEY=sk-...

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secret-aqui-generado-con-openssl-rand-base64-32

# OAuth GitHub (opcional)
GITHUB_ID=
GITHUB_SECRET=

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de datos PostgreSQL (opcional — sin esto usa localStorage)
DATABASE_URL=postgresql://user:password@localhost:5432/cognita
